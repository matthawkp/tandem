CONFIG_LOCALVERSION="-tandem"
CONFIG_DEFAULT_HOSTNAME="tandem"

# --- Not needed on a display appliance (and quicker to build without) ---
# CONFIG_SOUND is not set
# CONFIG_DRM_I915 is not set
# CONFIG_NETFILTER is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_AUDIT is not set
# CONFIG_HIBERNATION is not set
# CONFIG_SUSPEND is not set
# CONFIG_PCCARD is not set
# CONFIG_AGP is not set
# CONFIG_MD is not set
# CONFIG_QUOTA is not set
# CONFIG_SWAP is not set
# CONFIG_DEBUG_INFO_BTF is not set
# The internal disks are never touched: no SATA, no NVMe.
# CONFIG_ATA is not set
# CONFIG_BLK_DEV_NVME is not set

# --- Booting on a Mac ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_APPLE_PROPERTIES=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MAGIC_SYSRQ=y

# --- Screen ---
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_EFIDRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# The console leaves the boot menu's picture on screen until there's something to say: with
# "quiet", that's never, and the picture stays until the display program draws.
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_AMD_DC_SI=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_ACPI_VIDEO=y
CONFIG_BACKLIGHT_APPLE=y
# For trying the image in a virtual machine.
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_BOCHS=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_INPUT=y

# --- The Thunderbolt cable ---
CONFIG_USB4=y
CONFIG_USB4_NET=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_HOTPLUG_PCI_ACPI=y
CONFIG_INTEL_IOMMU=y
CONFIG_IPV6=y
CONFIG_IP_MULTICAST=y
CONFIG_PACKET=y
CONFIG_UNIX=y

# --- Keyboard, mouse, power button ---
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_APPLE=y
CONFIG_HID_MAGICMOUSE=y
CONFIG_UHID=y
CONFIG_ACPI_BUTTON=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_BCM=y

# --- The USB stick it booted from (settings and logs) ---
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_BLK_DEV_SD=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# --- Fans and temperatures (the SMC runs the fans itself; this is for reading them) ---
CONFIG_HWMON=y
CONFIG_SENSORS_APPLESMC=y
CONFIG_SENSORS_CORETEMP=y
